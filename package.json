{
  "name": "new-home-app",
  "productName": "New Home App",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11.18.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.12.0 || ^24.0.0 || >=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": ">=11.18.0",
      "onFail": "error"
    }
  },
  "description": "New Home App with a verified built-in bedroom and fully local layout planning.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wayne-Ch/foundry-local-new-home-app.git"
  },
  "homepage": "https://github.com/Wayne-Ch/foundry-local-new-home-app#readme",
  "main": "dist/main/main.mjs",
  "type": "module",
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "check:release-contract": "node scripts/check-release-contract.mjs",
    "build:main": "esbuild src/main/main.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/main/main.mjs --external:electron --external:foundry-local-sdk --sourcemap",
    "build:preload": "esbuild src/preload/preload.ts --bundle --platform=node --format=cjs --target=node22 --outfile=dist/preload/preload.cjs --external:electron --sourcemap",
    "build:renderer": "vite build",
    "build": "npm run clean && npm run build:main && npm run build:preload && npm run build:renderer",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "npm run check:release-contract && vitest run",
    "test:watch": "vitest",
    "test:integration": "tsx scripts/run-foundry-integration.ts",
    "test:audio-integration": "tsx scripts/run-audio-integration.ts",
    "test:nemotron-integration": "tsx scripts/run-nemotron-integration.ts",
    "benchmark:layout": "node scripts/run-layout-model-benchmarks.mjs",
    "probe:foundry": "tsx scripts/probe-foundry.ts",
    "probe:microphone-permission": "npm run build && node scripts/probe-electron-microphone.mjs",
    "probe:reset": "npm run build && node scripts/probe-electron-reset.mjs",
    "probe:stream-owner": "npm run build && node scripts/probe-electron-stream-owner.mjs",
    "probe:furniture-controls": "node scripts/probe-furniture-controls.mjs",
    "smoke:electron": "npm run build && node scripts/smoke-electron.mjs",
    "capture:ui": "npm run build && node scripts/capture-ui.mjs",
    "setup:native": "node node_modules/electron/install.js && npm rebuild esbuild foundry-local-sdk",
    "start": "npm run build && electron .",
    "start:built": "electron ."
  },
  "dependencies": {
    "foundry-local-sdk": "2.2.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "electron": "42.11.18",
    "esbuild": "0.28.2",
    "semver": "7.8.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "foundry-local-sdk@2.2.1": true,
    "electron@42.11.18": true
  }
}
